# Keep pnpm's default isolated node_modules (no hoisting). Every app resolves
# react through its own symlink into a single content-addressed store entry, so
# local dev and standalone builds see one React on disk.
#
# NOTE: this is NOT what makes React a singleton at runtime across the federated
# apps. Each app is built separately into its own bundle, so deduplication there
# is negotiated by Module Federation's `shared` config — see any vite.config.ts.
# pnpm's layout and MF's `shared` solve two different problems; do not conflate
# them when explaining this repo.
shamefully-hoist=false

# The React 18 ecosystem still ships packages advertising React 19 peers.
# Warnings here would be noise, and the singleton versions that actually matter
# are pinned explicitly in each app's `shared` block.
strict-peer-dependencies=false
